APP_ENV=development
PORT=8080
PATH_MIGRATE=migrations/000001_init.sql
CORS_ALLOWED_ORIGINS=*

# Redis cache. Location cache TTL supports duration strings or numeric seconds.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
LOCATION_CACHE_TTL=4320h

# Optional object storage for boundary payloads and future assets.
# Choose one provider example below, then copy its values into the active
# STORAGE_* settings. Leave STORAGE_PROVIDER empty to disable storage.
#
# Supabase Storage (S3 API):
# STORAGE_PROVIDER=s3
# STORAGE_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
# STORAGE_ACCESS_KEY=<supabase-s3-access-key>
# STORAGE_SECRET_KEY=<supabase-s3-secret-key>
# STORAGE_BUCKET_NAME=location-assets
# STORAGE_BASE_URL=https://<project-ref>.supabase.co/storage/v1/object/public/location-assets
# STORAGE_REGION=auto
# STORAGE_USE_SSL=true
# STORAGE_FORCE_PATH_STYLE=true
#
# Cloudflare R2:
# STORAGE_PROVIDER=r2
# STORAGE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# STORAGE_ACCESS_KEY=<r2-access-key-id>
# STORAGE_SECRET_KEY=<r2-secret-access-key>
# STORAGE_BUCKET_NAME=location-assets
# STORAGE_BASE_URL=https://<public-r2-domain>/location-assets
# STORAGE_REGION=auto
# STORAGE_USE_SSL=true
# STORAGE_FORCE_PATH_STYLE=true
#
# MinIO:
# STORAGE_PROVIDER=minio
# STORAGE_ENDPOINT=http://localhost:9000
# STORAGE_ACCESS_KEY=minioadmin
# STORAGE_SECRET_KEY=minioadmin
# STORAGE_BUCKET_NAME=location-assets
# STORAGE_BASE_URL=http://localhost:9000/location-assets
# STORAGE_REGION=us-east-1
# STORAGE_USE_SSL=false
# STORAGE_FORCE_PATH_STYLE=true

# Active storage settings (leave empty to disable storage).
STORAGE_PROVIDER=
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=example-access-key
STORAGE_SECRET_KEY=example-secret-key
STORAGE_BUCKET_NAME=location-assets
STORAGE_BASE_URL=
STORAGE_REGION=auto
STORAGE_USE_SSL=true
STORAGE_FORCE_PATH_STYLE=true

# Optional command override: serve, migrate, or import.
COMMAND=serve

# Seed data on first run when raw_locations is empty.
AUTO_SEED=true
AUTO_SEED_REQUIRED=false
SEED_FILE=data/wilayah.sql

# Prefer DATABASE_URL in production.
DATABASE_URL=postgres://location:location@localhost:5438/location?sslmode=disable

# Optional if DATABASE_URL is empty.
DB_HOST=localhost
DB_PORT=5438
DB_USERNAME=location
DB_PASS=location
DB_NAME=location
DB_SSLMODE=disable

# Docker entrypoint options.
RUN_MIGRATION=false
RUN_IMPORT=false
IMPORT_FILE=/app/data/wilayah.sql
